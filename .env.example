# ──────────────────────────────────────────────────────────────────────────────
# LeadRadar configuration — copy to `.env` and fill in.  NEVER commit `.env`.
# Only the LLM and database sections are required to run the pipeline.
# ──────────────────────────────────────────────────────────────────────────────

# ── Business profile: who the leads are for ──────────────────────────────────
BUSINESS_PROFILE=profiles/acme_equipment_rental.toml

# Countries run by `python main.py` with no arguments (default: all configured)
ENABLED_COUNTRIES=SPAIN,ITALY

# ── LLM provider: "azure" (default) or "mistral" ─────────────────────────────
LLM_PROVIDER=azure
AZURE_ENDPOINT=https://<your-resource>.openai.azure.com/openai/v1
AZURE_API_KEY=
DEPLOYMENT_SCORING=gpt-4.1-mini
DEPLOYMENT_WRITING=gpt-4.1-mini

MISTRAL_API_KEY=
MISTRAL_MODEL_SCORING=mistral-medium-latest
MISTRAL_MODEL_WRITING=mistral-large-latest

# ── Database: SQL Server / Azure SQL (run sql/schema.sql once) ───────────────
AZURE_SQL_SERVER=localhost,1433
AZURE_SQL_DATABASE=leadradar
AZURE_SQL_USERNAME=sa
AZURE_SQL_PASSWORD=
# true for a local SQL Server container (self-signed certificate)
AZURE_SQL_TRUST_SERVER_CERTIFICATE=true

# ── Email ────────────────────────────────────────────────────────────────────
#   file  → writes each email to MAIL_OUTBOX_DIR as .html (no setup — great for demos)
#   smtp  → any SMTP relay
#   graph → Microsoft Graph sendMail (Entra ID app with the Mail.Send permission)
MAIL_BACKEND=file
MAIL_OUTBOX_DIR=outbox
EMAIL_SENDER=leadradar@example.com
EMAIL_RECIPIENTS=sales@example.com
EMAIL_CC=
# Optional per-country overrides:
# RECIPIENTS_SPAIN=sales-es@example.com
# CC_SPAIN=manager-es@example.com

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# Public URL of the web app (deep links in emails)
APP_BASE_URL=http://localhost:8000

# ── Web app sign-in (optional — leave empty to disable) ───────────────────────
AAD_TENANT_ID=
AAD_CLIENT_ID=
AAD_CLIENT_SECRET=
AAD_REDIRECT_URI=http://localhost:8000/auth/callback
# Generate with:  python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=

# ── Contact finder (optional — Clay Public API + Serper) ─────────────────────
# Routine IDs are workspace-specific: publish the four Functions in your own
# Clay workspace (see clay_contact_finder/README.md).
CLAY_API_KEY=
CLAY_DOMAIN_ROUTINE_ID=
CLAY_ENRICH_COMPANY_ROUTINE_ID=
CLAY_EMAIL_ROUTINE_ID=
CLAY_PHONE_ROUTINE_ID=
SERPER_API_KEY=

# ── Tuning ───────────────────────────────────────────────────────────────────
RSS_SLEEP_S=0.1

# Prefect schedule (flows/deploy.py)
LEADRADAR_CRON=0 7 * * 1-5
LEADRADAR_TZ=UTC
